# ScientificBrain — cloud inference first, aligned with EDUAI
# Configure real secrets in Vercel Environment Variables. Never commit real secret keys.

SCIBRAIN_INFERENCE_MODE=cloud
SCIBRAIN_ENABLE_LOCAL_FALLBACK=false
SCIBRAIN_DEFAULT_TASK=research

# Production API protection. Supabase Auth becomes the primary user identity layer.
SCIBRAIN_REQUIRE_API_TOKEN=false
SCIBRAIN_API_TOKEN=

# Production persistence / Auth / Storage.
SCIBRAIN_STORAGE_BACKEND=supabase
SUPABASE_URL=https://cwbnvukerekgcedcyydd.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Optional server-only secret/service key for maintenance jobs. Do not expose in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Open-access literature services
UNPAYWALL_EMAIL=
OPENALEX_MAILTO=

# Optional general-web research provider. If absent, Research Agent still uses
# OpenAlex, arXiv, Crossref and Unpaywall and returns DOI/landing links for manual access.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Google AI / Gemini — primary online provider
GEMINI_API_KEY=
GEMINI_API_KEY_TEXT=
GOOGLE_TEXT_MODEL_PRIMARY=gemini-3.6-flash
GOOGLE_TEXT_MODEL_LITE=gemini-3.5-flash-lite
GEMINI_TEXT_MODEL_PRIMARY=gemini-3.6-flash
GEMINI_TEXT_MODEL_LITE=gemini-3.5-flash-lite
# Optional dedicated multimodal model. Falls back to GOOGLE_TEXT_MODEL_PRIMARY.
GOOGLE_VISION_MODEL=gemini-3.6-flash

# Groq
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_RESEARCH_MODEL=groq/compound

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_TEXT_MODEL=openrouter/auto
OPENROUTER_STRUCTURED_MODEL=openrouter/auto
# Optional dedicated multimodal model. openrouter/auto is used when omitted.
OPENROUTER_VISION_MODEL=openrouter/auto
OPENROUTER_PROVIDER_SORT=price
OPENROUTER_ALLOW_DATA_COLLECTION=false
OPENROUTER_ZDR_ONLY=false
OPENROUTER_REFERER=
OPENROUTER_APP_TITLE=ScientificBrain

# Cerebras
CEREBRAS_API_KEY=
CEREBRAS_TEXT_MODEL=gpt-oss-120b

# Together
TOGETHER_API_KEY=
TOGETHER_API_KEY_1=
TOGETHER_API_KEY_2=
TOGETHER_API_KEY_3=
TOGETHER_TEXT_MODEL=Qwen/Qwen3.5-9B

# Shared HTTP timeout
EDUAI_AI_PROVIDER_TIMEOUT_MS=60000
# Multimodal page analysis may use a separate timeout.
SCIBRAIN_VISION_TIMEOUT_MS=60000

# EDUAI-compatible routing orders. Unknown/unconfigured providers are skipped.
EDUAI_AI_PROVIDER_ORDER_TEXT=google,vertex-model-cloud,groq,openrouter,cerebras,together
EDUAI_AI_PROVIDER_ORDER_STRUCTURED=google,vertex-model-cloud,groq,openrouter,cerebras,together
EDUAI_AI_PROVIDER_ORDER_LONG_CONTEXT=google,vertex-model-cloud,openrouter,groq,cerebras,together
EDUAI_AI_PROVIDER_ORDER_RESEARCH=google,groq,openrouter
EDUAI_AI_PROVIDER_ORDER_RETRIEVAL=google
EDUAI_AI_PROVIDER_ORDER_CODE=google,vertex-model-cloud,groq,cerebras,openrouter,together

# EDUAI Vertex Model Cloud remains optional. ScientificBrain skips it unless a compatible
# provider implementation is configured in a later phase.
VERTEX_MODEL_CLOUD_ENABLED=false
VERTEX_MODEL_CLOUD_ENDPOINT_ID=
VERTEX_MODEL_CLOUD_MODEL_ID=
VERTEX_MODEL_CLOUD_LOCATION=us-central1

# Optional local inference. Do NOT set localhost Ollama on Vercel.
SCIBRAIN_OLLAMA_MODEL=qwen3:8b
SCIBRAIN_OLLAMA_URL=http://127.0.0.1:11434

# Generic OpenAI-compatible endpoint retained for custom/self-hosted providers.
SCIBRAIN_API_BASE=
SCIBRAIN_MODEL=
SCIBRAIN_API_KEY=
